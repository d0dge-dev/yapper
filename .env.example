# Yapper server configuration. Copy to .env (mode 600) and fill in. The server reads ./.env, or the file in
# YAP_ENV_FILE; variables already set in the environment win. Values are taken literally (no quotes).
# Commented lines show the default. Leave optional lines commented: an empty value is not the same as unset.

# ---------------------------------------------------------------- T3 Code (required)
# T3 server URL (T3 Code must run on this host or be reachable from it).
T3_URL=http://127.0.0.1:3773
# T3 bearer token: t3 auth session issue --scope orchestration:read --scope orchestration:operate --ttl 365d --label yapper --json
T3_TOKEN=

# ---------------------------------------------------------------- HTTP listener
# Address to bind; keep 127.0.0.1 when a reverse proxy / tailscale serve on this host is the only way in.
# YAP_HOST=127.0.0.1
# Port for the web app, API and /call WebSocket.
# YAP_PORT=8790
# Alternative env file to read instead of ./.env (set it in the real environment, not in this file).
# YAP_ENV_FILE=

# ---------------------------------------------------------------- Access (Yapper has no login of its own)
# Comma-separated IPs of your reverse proxy; only requests from these may carry the user header below.
# YAP_TRUSTED_PROXIES=
# Header your SSO proxy sets with the authenticated user (Authelia/Authentik: Remote-User; oauth2-proxy: X-Forwarded-User). "none" disables.
# YAP_AUTH_HEADER=Remote-User
# Header trusted on requests from loopback (tailscale serve sets Tailscale-User-Login). "none" disables.
# YAP_LOOPBACK_AUTH_HEADER=Tailscale-User-Login
# Comma-separated users allowed to call (values of the headers above). Empty = anyone your front authenticates.
# YAP_ALLOWED_USERS=
# 1 = let unauthenticated loopback requests in (local testing only; never with a reverse proxy on the same host).
# YAP_DEV=0

# ---------------------------------------------------------------- Callbacks and the agent tool
# Shared secret for scripts/yap-mcp.ts (call_me_back) → POST /api/agent/callback on loopback. Unset = tool disabled. e.g. openssl rand -hex 32
# YAP_AGENT_TOKEN=
# Local-time window in which agent-initiated calls (kind assistance/info) may ring, "from-to" in hours; 24 = midnight.
# YAP_CALL_HOURS=7-22
# Directory for registered phones, pending callbacks and the call log (calls.json, audio/).
# YAP_STATE_DIR=./state
# Days to keep call-log entries and their audio.
# CALL_LOG_DAYS=30

# ---------------------------------------------------------------- Speech (CPU defaults: Parakeet ASR, Piper TTS, Silero VAD)
# Model directory filled by scripts/fetch-models.sh.
# YAP_MODELS=./models
# 1 = keep what callers say (16 kHz WAV + transcript) in YAP_RECORD_DIR, for testing ASR changes. Off by default.
# YAP_RECORD=0
# Where recordings go.
# YAP_RECORD_DIR=./recordings
# Delete recorded WAVs older than this many days.
# YAP_RECORD_DAYS=30

# Recognition engine: unset = Parakeet on the CPU; gpu = Whisper service (gpu-services/asr), Parakeet as fallback.
# YAP_ASR=gpu
# URL of the GPU ASR service.
# YAP_GPU_ASR_URL=http://127.0.0.1:8801
# Language for the GPU ASR: auto (German or English per segment), de or en.
# YAP_GPU_ASR_LANG=auto

# Voice engine: unset = Piper on the CPU; gpu = Qwen3-TTS service (gpu-services/tts); azure = Azure AI Speech. Piper is the fallback.
# YAP_TTS=gpu
# URL of the GPU TTS service.
# YAP_GPU_TTS_URL=http://127.0.0.1:8800
# auto = the service detects German/English per sentence; fixed = send the call's language.
# YAP_GPU_LANG=auto
# Voice name for both languages (empty = the service's per-language default).
# YAP_GPU_VOICE=
# Voice for German sentences (overrides YAP_GPU_VOICE).
# YAP_GPU_VOICE_DE=
# Voice for English sentences (overrides YAP_GPU_VOICE).
# YAP_GPU_VOICE_EN=
# Azure AI Speech key (YAP_TTS=azure). Only reply text is sent to Azure, never audio.
# AZURE_SPEECH_KEY=
# Azure region, e.g. westeurope.
# AZURE_SPEECH_REGION=
# Azure voice for German (default de-DE-FlorianMultilingualNeural).
# YAP_AZURE_VOICE_DE=
# Azure voice for English (default de-DE-FlorianMultilingualNeural, which also reads English).
# YAP_AZURE_VOICE_EN=

# ---------------------------------------------------------------- WebRTC audio
# 0 = WebSocket audio only.
# YAP_RTC=1
# Comma-separated IPv4 addresses offered as ICE host candidates (default: all non-loopback IPv4 addresses of this host).
# YAP_RTC_IPS=
# Fixed UDP port range for ICE, e.g. 40000-40100 for a firewall rule (default: random ports).
# YAP_RTC_PORTS=

# ---------------------------------------------------------------- Not read by the server
# Android build (scripts/android-build.sh, mobile/capacitor.config.ts): YAPPER_SERVER_URL (https URL of this server),
#   YAPPER_ALLOW_NAVIGATION (hosts that may open inside the app, e.g. your SSO login host).
# Test scripts: TIMEOUT (rtc-client-smoke.ts, ms), ROUNDS (fake-caller-rtc.ts). CLAUDE_CODE_SESSION_ID is set by Claude Code.
